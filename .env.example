# SkillGuard Sentinel — copier vers .env et adapter

# Clé partagée entre SPFx et Sentinel (en-tête X-API-Key)
SENTINEL_API_KEY=changez-moi-en-production

# Space Hugging Face (modèle LLM)
HF_SPACE_URL=https://dgalai-skillflow.hf.space
HF_CHAT_PATH=/api/chat
HF_HEALTH_PATH=/api/health
# Token HF si le Space est privé
HF_TOKEN=
HF_REQUEST_TIMEOUT=60

# CORS : URL SharePoint (séparer par des virgules)
CORS_ORIGINS=https://votre-tenant.sharepoint.com

# Quotas et validation
MAX_REQUESTS_PER_MINUTE=5
MAX_PROMPT_LENGTH=4000
MAX_CONTEXT_LENGTH=8000
ALLOWED_ROLES=employee,manager,rh,admin,stagiaire

# Audit optionnel (fichier local ou volume Docker)
AUDIT_LOG_PATH=

# Liste noire (virgules)
PROMPT_BLACKLIST=ignore all previous,oublie les instructions,system prompt,donne moi le mot de passe,salary,salaire,confidentiel,bypass,hack
